<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jasmine | Creative Web Developer Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <style>
        /* --- Premium Design Tokens --- */
        :root {
            --bg-main: #0B0F19;         /* Ultra-dark sleek space blue */
            --bg-card-dark: #131A26;    /* Deep slate blue for containers */
            --accent-glow: #22C55E;     /* Vibrant emerald mint from Image 2 */
            --accent-glow-rgb: 34, 197, 94;
            --gradient-profile: linear-gradient(135deg, #FF0844 0%, #FFB199 100%); /* Premium energetic sunset */
            --text-primary: #F3F4F6;
            --text-secondary: #9CA3AF;
            --input-bg: #1F2937;
            --transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); /* Ultra-smooth ease-out */
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            line-height: 1.6;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* --- Ambient Background Glows --- */
        body::before {
            content: '';
            position: fixed;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255, 8, 68, 0.15) 0%, transparent 70%);
            top: -100px;
            left: -100px;
            z-index: -1;
        }
        body::after {
            content: '';
            position: fixed;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(34, 197, 94, 0.1) 0%, transparent 70%);
            bottom: -150px;
            right: -150px;
            z-index: -1;
        }

        a { text-decoration: none; color: inherit; }
        li { list-style: none; }

        /* --- Custom Scrollbar --- */
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: var(--bg-main); }
        ::-webkit-scrollbar-thumb { background: #243249; border-radius: 5px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--accent-glow); }

        /* --- Glassmorphism Navbar --- */
        header {
            background: rgba(11, 15, 25, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 20px 8%;
            position: fixed;
            width: 100%;
            top: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            z-index: 1000;
        }

        .header-logo {
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.5px;
            background: var(--gradient-profile);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-logo .made-with {
            font-size: 12px;
            color: var(--text-secondary);
            font-weight: 400;
            margin-left: 10px;
            -webkit-text-fill-color: var(--text-secondary); /* Override gradient clip */
        }

        .nav-links { display: flex; gap: 35px; }
        .nav-links a {
            font-weight: 500;
            font-size: 15px;
            color: var(--text-secondary);
            transition: var(--transition);
            position: relative;
        }
        .nav-links a:hover, .nav-links a.active {
            color: var(--text-primary);
        }
        .nav-links a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -6px;
            left: 0;
            background-color: var(--accent-glow);
            transition: var(--transition);
        }
        .nav-links a:hover::after { width: 100%; }

        /* --- Global Sections Layout --- */
        section {
            padding: 140px 8% 80px 8%;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .section-title {
            font-size: 38px;
            font-weight: 700;
            margin-bottom: 60px;
            text-align: center;
            position: relative;
            letter-spacing: -0.5px;
        }
        .section-title::after {
            content: '';
            display: block;
            width: 50px;
            height: 4px;
            background: var(--accent-glow);
            margin: 10px auto 0 auto;
            border-radius: 2px;
        }

        /* --- Section 1: Hero Profile Card (Image 1 Redesign) --- */
        #profile-section { align-items: center; }

        .portfolio-profile-card {
            display: flex;
            background: rgba(19, 26, 38, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 24px;
            overflow: hidden;
            width: 100%;
            max-width: 950px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Card Left side */
        .profile-card-left {
            flex: 1.1;
            background: var(--gradient-profile);
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            position: relative;
        }

        .profile-img-container {
            position: relative;
            margin-bottom: 25px;
        }
        .profile-img-container img {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            transition: var(--transition);
        }
        .profile-img-container:hover img {
            transform: scale(1.04);
            border-color: rgba(255, 255, 255, 0.6);
        }

        .profile-info h1 {
            font-size: 32px;
            font-weight: 700;
            text-transform: capitalize;
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }
        .profile-info p {
            font-size: 16px;
            color: rgba(255, 255, 255, 0.85);
            font-weight: 400;
            margin-bottom: 30px;
        }

        .social-icons {
            display: flex;
            gap: 12px;
            margin-bottom: 35px;
        }
        .social-icons a {
            background: rgba(11, 15, 25, 0.8);
            color: #fff;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 16px;
            transition: var(--transition);
            border: 1px solid rgba(255,255,255,0.05);
        }
        .social-icons a:hover {
            transform: translateY(-5px);
            background: #fff;
            color: #FF0844;
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }

        .download-cv-btn {
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 14px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.25);
            transition: var(--transition);
        }
        .download-cv-btn:hover {
            background: #fff;
            color: #FF0844;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        /* Card Right side */
        .profile-card-right {
            flex: 1.4;
            padding: 50px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .profile-card-right h2 {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--accent-glow);
            margin-bottom: 25px;
            font-weight: 700;
        }

        .contact-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-bottom: 35px;
            padding-bottom: 25px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }
        .detail-label {
            font-size: 12px;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 4px;
            letter-spacing: 0.5px;
        }
        .detail-value {
            font-size: 15px;
            font-weight: 500;
            color: var(--text-primary);
        }

        /* Contact Inner Form */
        .profile-card-right input, .profile-card-right textarea {
            width: 100%;
            background: var(--input-bg);
            border: 1px solid rgba(255,255,255,0.05);
            padding: 14px 18px;
            margin-bottom: 16px;
            border-radius: 12px;
            color: #fff;
            font-size: 14px;
            transition: var(--transition);
        }
        .profile-card-right input:focus, .profile-card-right textarea:focus {
            outline: none;
            border-color: var(--accent-glow);
            box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15);
        }
        .profile-card-right textarea { height: 110px; resize: none; }

        .send-message-btn {
            background: var(--text-primary);
            color: var(--bg-main);
            padding: 14px 35px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            border: none;
            align-self: flex-end;
            transition: var(--transition);
        }
        .send-message-btn:hover {
            background: var(--accent-glow);
            color: var(--bg-main);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(34, 197, 94, 0.3);
        }

        /* --- Section 2: Projects Grid (Image 2 Redesign) --- */
        #projects-section { background-color: #080C14; }

        .project-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            max-width: 1100px;
            margin: 0 auto;
            width: 100%;
        }

        .project-card {
            background: var(--bg-card-dark);
            padding: 30px;
            border-radius: 20px;
            display: flex;
            gap: 20px;
            cursor: pointer;
            transition: var(--transition);
            border: 1px solid rgba(255, 255, 255, 0.03);
            position: relative;
            overflow: hidden;
        }
        .project-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(800px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(255,255,255,0.04), transparent 40%);
            z-index: 1;
            pointer-events: none;
        }
        .project-card:hover {
            transform: translateY(-6px);
            border-color: rgba(34, 197, 94, 0.3);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
        }

        .project-icon-box {
            background: rgba(255, 255, 255, 0.04);
            width: 55px;
            height: 55px;
            border-radius: 14px;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: var(--transition);
        }
        .project-icon-box i { font-size: 24px; color: var(--text-secondary); transition: var(--transition); }
        .project-card:hover .project-icon-box { background: rgba(34, 197, 94, 0.1); }
        .project-card:hover .project-icon-box i { color: var(--accent-glow); }

        .project-details { flex: 1; z-index: 2; }
        .project-details h3 { font-size: 20px; font-weight: 600; margin-bottom: 8px; color: var(--text-primary); transition: var(--transition); }
        .project-card:hover .project-details h3 { color: var(--accent-glow); }
        .project-details p { color: var(--text-secondary); font-size: 14px; margin-bottom: 18px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

        .tech-tags { display: flex; gap: 8px; flex-wrap: wrap; }
        .tag { font-size: 12px; font-weight: 500; background: rgba(255, 255, 255, 0.05); color: var(--text-secondary); padding: 4px 12px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.03); }

        /* --- Elegant Global Showcase Modal --- */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(5, 8, 14, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .modal.open { display: flex; }

        .modal-content {
            background: var(--bg-card-dark);
            border: 1px solid rgba(255, 255, 255, 0.08);
            width: 100%;
            max-width: 500px;
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.6);
            position: relative;
            text-align: center;
            animation: modalSlideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @keyframes modalSlideUp {
            from { opacity: 0; transform: translateY(40px) scale(0.96); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .modal-close {
            position: absolute;
            top: 20px; right: 24px;
            cursor: pointer;
            font-size: 22px;
            color: var(--text-secondary);
            transition: var(--transition);
        }
        .modal-close:hover { color: var(--text-primary); }
        .modal-icon i { font-size: 56px; color: var(--accent-glow); margin-bottom: 20px; }
        .modal-details h3 { font-size: 24px; margin-bottom: 12px; font-weight: 700; }
        .modal-details p { color: var(--text-secondary); font-size: 15px; line-height: 1.6; margin-bottom: 25px; }

        .restart-btn {
            background: var(--accent-glow);
            color: var(--bg-main);
            font-weight: 600;
            padding: 12px 30px;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            font-size: 14px;
            transition: var(--transition);
        }
        .restart-btn:hover {
            box-shadow: 0 0 20px rgba(34, 197, 94, 0.4);
            transform: scale(1.02);
        }

        /* --- Full Screen Responsive Adaptability --- */
        @media (max-width: 950px) {
            .portfolio-profile-card { flex-direction: column; }
            .profile-card-left { padding: 60px 40px; }
            .profile-card-right { padding: 40px; }
            .contact-details { grid-template-columns: 1fr; gap: 15px; }
            .project-list { grid-template-columns: 1fr; }
            header { padding: 20px 5%; }
            .nav-links { gap: 20px; }
        }
    </style>
</head>
<body>

