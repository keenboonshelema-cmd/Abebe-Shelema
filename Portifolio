        </section>

        <section id="projects-section">
            <h2 class="section-title">Featured Projects</h2>
            <div class="project-list">
                
                <div class="project-card" data-project="survivorship">
                    <div class="project-icon-box"><i class="fa-solid fa-brain"></i></div>
                    <div class="project-details">
                        <h3>Survivorship bias</h3>
                        <p>An interactive, psychology-focused gamified micro-learning feature that highlights selection heuristics.</p>
                        <div class="tech-tags">
                            <span class="tag">Cognitive Framework</span>
                            <span class="tag">UI/UX Layout</span>
                        </div>
                    </div>
                </div>

                <div class="project-card" data-project="profilesettings">
                    <div class="project-icon-box"><i class="fa-solid fa-sliders"></i></div>
                    <div class="project-details">
                        <h3>Profile settings</h3>
                        <p>A sophisticated mobile security matrix enabling seamless updates to identities and account encryption data keys.</p>
                        <div class="tech-tags">
                            <span class="tag">Mobile UX</span>
                            <span class="tag">Security Core</span>
              