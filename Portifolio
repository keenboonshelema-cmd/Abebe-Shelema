        <div class="header-logo">
            jasmine<span class="made-with">Made with ❤️ by Learning Robo</span>
        </div>
        <ul class="nav-links">
            <li><a href="#profile-section" class="active">Profile</a></li>
            <li><a href="#projects-section">Projects</a></li>
        </ul>
    </header>

